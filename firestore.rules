rules_version = '2';

// Security rules for Tălmaci's multi-user/multi-group model.
//
// This is the real enforcement layer — the app's UI hides buttons the
// current user shouldn't see, but that's UX only. Anyone can call the
// Firestore SDK directly from devtools, so these rules are what actually
// stop someone from reading or writing another group's data.
//
// Data model:
//   /users/{uid}      { email, displayName, role: 'admin'|'user', groupId, createdAt }
//                     (the super-admin is not a role here — see isSuperAdmin)
//                     A removed member has no groupId and instead
//                     { removedFrom: groupId, removedAt } — see /users below.
//   /groups/{groupId} { name, createdBy, createdAt }
//   /groups/{groupId}/activity/{entryId} { action, by, byName, songId, songTitle, ..., at }
//   /invites/{code}   { groupId, createdBy, createdAt }
//   /songs/{songId}   { title, originalVerses: [{ mark, lyrics }], groupId, shared, status, workers, versionOrder, demoUrl, createdBy, createdAt, updatedAt }
//   /songs/{songId}/versions/{versionId} { title, verses: [{ mark, lyrics }], createdBy, createdAt, updatedAt }
//   /songs/{songId}/versions/{versionId}/notes/{noteId} { text, by, byName, at, anchor?, parentId?, resolved?, resolvedBy?, resolvedAt?, hearts? }
//   /users/{uid}/seen/{songId} { [versionId]: ms, [versionId:threadId]: ms }
//
// Any group member can create a song, but editing (rename, original text)
// or deleting one is limited to whoever created it, or an admin — same
// ownership model as translation versions below. The one exception is a
// shared song's status, who is working on it and the order its versions
// are shown in (`status`, `workers`, `versionOrder`): coordinating is the
// whole group's business, so any member may change those fields, and only
// those. Translation versions
// inherit the parent song's group check via get().
//
// `shared` (bool) marks whether the rest of the group can see a song at
// all. A personal song (shared == false) is readable, writable and
// deletable only by whoever created it — not even an admin gets an
// override, since the whole point of "not shared" is that it isn't the
// group's to manage.
//
// PASTE ORDER MATTERS FOR THIS FILE. The songs read rule below requires
// `shared` to be an explicit boolean on every document, not absent — a
// song predating this field won't satisfy it. Before pasting this version
// in, every existing song needs `shared: true` backfilled onto it (a song
// that predates the field was always visible to the whole group, so true
// is the correct value, not a guess). Run the one-time migration snippet
// first, confirm it reports 0 left to patch, and only then replace the
// rules — pasting this first would make every legacy song vanish from
// both lists until it's patched, not just personal ones.
//
// Why a plain "absent means shared" tolerance (like listVersions below
// still has, safely) doesn't work here: `listSongs` has to be two actual
// queries — one for `shared == true`, one for `createdBy == you` — because
// Firestore proves a *list* query safe from its shape alone, before
// running it, and a query only constrained by groupId can't prove
// anything about shared/createdBy for documents it hasn't looked at yet.
// Each of those two queries needs its own field to literally equal
// something for Firestore to accept it, and "the field is absent" isn't a
// value a query can match against.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function myGroup() {
      return myProfile().groupId;
    }
    // The app owner, known by their Google account rather than by anything
    // stored in a profile, so no write to Firestore can ever grant it. Only
    // they invite people and decide who is an admin, and they have every
    // admin power over songs too.
    function isSuperAdmin() {
      return request.auth.token.email == 'andrei4.bulzan@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function isAdmin() {
      return isSuperAdmin() || myProfile().role == 'admin';
    }
    function unchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    match /users/{userId} {
      // Read your own profile, or any profile in your own group (member
      // lists). The super-admin also reads those removed from their group,
      // to add one back.
      allow read: if isSignedIn() && (userId == request.auth.uid
        || resource.data.groupId == myGroup()
        || (isSuperAdmin() && resource.data.removedFrom == myGroup()));

      // First write ever to this doc — either self-granted admin on a group
      // you just created, or self-granted 'user' on joining an existing group.
      allow create: if isSignedIn() && userId == request.auth.uid
        && request.resource.data.groupId is string
        && (
          (request.resource.data.role == 'admin'
            && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId))
            && get(/databases/$(database)/documents/groups/$(request.resource.data.groupId)).data.createdBy == request.auth.uid)
          ||
          (request.resource.data.role == 'user'
            && exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)))
        );

      // These updates are allowed, and nothing else about a profile can
      // ever change. The super-admin flips a group member's role...
      allow update: if isSignedIn() && isSuperAdmin()
        && resource.data.groupId == myGroup()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
        && request.resource.data.role in ['admin', 'user'];

      // ...removes someone else from their group: the profile loses its
      // groupId, so every rule that goes by myGroup() shuts them out, and
      // goes back to a plain role. It is kept rather than deleted on
      // purpose — a profile that exists can't be created again, so the
      // removed member can't simply join the group anew...
      allow update: if isSignedIn() && isSuperAdmin()
        && userId != request.auth.uid
        && resource.data.groupId == myGroup()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['groupId', 'role', 'removedFrom', 'removedAt'])
        && !('groupId' in request.resource.data)
        && request.resource.data.role == 'user'
        && request.resource.data.removedFrom == resource.data.groupId
        && request.resource.data.removedAt is number;

      // ...and adds one back, into the group they were removed from.
      allow update: if isSignedIn() && isSuperAdmin()
        && resource.data.removedFrom == myGroup()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['groupId', 'removedFrom', 'removedAt'])
        && request.resource.data.groupId == resource.data.removedFrom
        && !('removedFrom' in request.resource.data)
        && !('removedAt' in request.resource.data);

      // ...and a member brings their own name and email in line with their
      // Google account, which the app does on each start (see auth.js).
      allow update: if isSignedIn() && userId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'email'])
        && request.resource.data.displayName is string
        && request.resource.data.email is string;

      allow delete: if false;

      // When this member last read each version's observations, per song.
      // Their own business only.
      match /seen/{songId} {
        allow read, write: if isSignedIn() && userId == request.auth.uid;
      }

      // The devices where this member turned notifications on, by their
      // messaging token (see js/push.js). Their own business too; the Cloud
      // Function that sends the notifications reads them past the rules.
      match /devices/{token} {
        allow read, delete: if isSignedIn() && userId == request.auth.uid;
        allow create, update: if isSignedIn() && userId == request.auth.uid
          && request.resource.data.token == token
          && request.resource.data.at is number;
      }
    }

    match /groups/{groupId} {
      allow read: if isSignedIn() && groupId == myGroup();
      // No self-serve group creation at all — the app owner creates every
      // group by hand (Firebase console / a one-off script). Invite codes
      // are the only way anyone else ever joins.
      allow create: if false;
      allow update, delete: if false;

      // The activity log (see js/activity.js). Any member of the group
      // reads it, both the whole list and one song's share of it. Only
      // shared songs are ever logged, so nothing in it is about a song a
      // member couldn't already open.
      // Any member writes their own entries, never someone else's, and may
      // afterwards only move their own entry's time forward — that is how
      // a run of autosaves folds into one entry. Nothing is ever deleted.
      // Both list queries are provable as is: groupId is part of the path,
      // not a field that would have to be filtered on.
      match /activity/{entryId} {
        allow read: if isSignedIn() && groupId == myGroup();
        allow create: if isSignedIn() && groupId == myGroup()
          && request.resource.data.by == request.auth.uid
          && request.resource.data.action is string
          && request.resource.data.at is number;
        allow update: if isSignedIn() && groupId == myGroup()
          && resource.data.by == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['at'])
          && request.resource.data.at is number;
        allow delete: if false;
      }
    }

    match /invites/{code} {
      // Readable by any signed-in user so a brand-new profile-less user can
      // redeem a code before they belong to any group.
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isSuperAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.groupId == myGroup();
      allow update, delete: if false;
    }

    match /songs/{songId} {
      // Two different tolerances on purpose. `isShared` (used by
      // update/delete and by the versions rule below, neither of which
      // ever runs as a list query) treats an absent field as shared — the
      // correct reading for a song that predates this feature. The read
      // rule below needs `shared` to be an actual `true`, because it has
      // to stay provable for a list query — see the file header.
      function isShared(data) {
        return data.shared != false;
      }
      // One rule serves both get and list here, unlike the tightened
      // version this replaced: this shape is provable for get (a real
      // document, always) AND for both of listSongs' two queries — one
      // constrained by `shared == true`, one by `createdBy == you` — since
      // each query's own equality filter is exactly what satisfies one
      // side of this OR for every document it could possibly return. A
      // raw query with neither filter (list everything in the group) is
      // NOT provable and gets rejected outright, which is the point: nothing
      // can enumerate a group's songs including personal ones anymore.
      allow read: if isSignedIn() && resource.data.groupId == myGroup()
        && (resource.data.shared == true || resource.data.createdBy == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.groupId == myGroup();
      // Only status, workers and the versions' order changed, and to a
      // status that exists.
      function onlyStatusChange() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'workers', 'versionOrder'])
          && (!('status' in request.resource.data) || request.resource.data.status in ['draft', 'review', 'final'])
          && (!('workers' in request.resource.data) || request.resource.data.workers is list)
          && (!('versionOrder' in request.resource.data) || request.resource.data.versionOrder is list);
      }
      allow update: if isSignedIn() && resource.data.groupId == myGroup() && unchanged('groupId')
        && (resource.data.createdBy == request.auth.uid
            || (isAdmin() && isShared(resource.data))
            || (isShared(resource.data) && onlyStatusChange()));
      allow delete: if isSignedIn() && resource.data.groupId == myGroup()
        && (resource.data.createdBy == request.auth.uid || (isAdmin() && isShared(resource.data)));

      // Everyone in the group can see every version and add new ones, but
      // editing/deleting an existing version is limited to whoever created
      // it, or an admin — this is what stops one person's draft from being
      // overwritten by someone else without permission. A personal song's
      // versions follow the same not-even-an-admin rule as the song itself.
      match /versions/{versionId} {
        function parentSong() {
          return get(/databases/$(database)/documents/songs/$(songId)).data;
        }
        function canSeeParent() {
          return parentSong().groupId == myGroup()
            && (isShared(parentSong()) || parentSong().createdBy == request.auth.uid);
        }
        allow read: if isSignedIn() && canSeeParent();
        allow create: if isSignedIn() && canSeeParent()
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isSignedIn() && canSeeParent()
          && (resource.data.createdBy == request.auth.uid || (isAdmin() && isShared(parentSong())));

        // The team's observations on a version. Any member reads them and,
        // on a shared song only — a personal one has no team to leave them —
        // adds them, in their own name. Reading is not limited the same way
        // so that deleting a personal song's versions can still list them.
        // One may be on a verse (`anchor`) or answer another (`parentId`),
        // which makes a thread. Nobody edits one's text; any member marks a
        // thread done or not, on its first observation, and only that, and
        // gives any one a heart or takes their own back — only their own. Its
        // author or an admin deletes one — and so does whoever may delete
        // the version or the song, which has to clear them out first (see
        // db.js).
        match /notes/{noteId} {
          function parentVersion() {
            return get(/databases/$(database)/documents/songs/$(songId)/versions/$(versionId)).data;
          }
          allow read: if isSignedIn() && canSeeParent();
          allow create: if isSignedIn() && canSeeParent() && isShared(parentSong())
            && request.resource.data.by == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 4000
            && request.resource.data.at is number
            && request.resource.data.get('parentId', '') is string
            && request.resource.data.get('anchor', {}) is map
            && request.resource.data.get('anchor', {}).get('quote', '') is string
            && request.resource.data.get('anchor', {}).get('quote', '').size() <= 4000
            && !('resolved' in request.resource.data)
            && !('hearts' in request.resource.data);
          function heartsChange() {
            let before = resource.data.get('hearts', []).toSet();
            let after = request.resource.data.get('hearts', []).toSet();
            return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hearts'])
              && request.resource.data.get('hearts', []) is list
              && after.difference(before).hasOnly([request.auth.uid])
              && before.difference(after).hasOnly([request.auth.uid]);
          }
          allow update: if isSignedIn() && canSeeParent() && isShared(parentSong())
            && (heartsChange()
                || (!('parentId' in resource.data)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['resolved', 'resolvedBy', 'resolvedAt'])
                    && request.resource.data.resolved is bool
                    && request.resource.data.resolvedBy == request.auth.uid
                    && request.resource.data.resolvedAt is number));
          allow delete: if isSignedIn() && canSeeParent()
            && (resource.data.by == request.auth.uid
                || isAdmin()
                || parentVersion().createdBy == request.auth.uid
                || parentSong().createdBy == request.auth.uid);
        }
      }
    }
  }
}
